# Demo works without environment variables. Copy to .env.local to configure.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional deployment subdirectory. Leave empty for a domain-root site.
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_PUBLISHER_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
PARTNER_ADS_PARTNER_ID=
# Server-only base URL of a separately running partner-ads-json-feed service.
# Use the deployed service URL outside local development.
PARTNER_ADS_API_URL=http://localhost:1337
# Only use DKK extracts for a single approved advertiser per entry.
# rid is the feed extract ID, not the program, partner, or banner ID.
# PARTNER_ADS_FEEDS='[{"rid":"1234","programId":"12345","merchant":"Din butik","approved":true,"currency":"DKK","bannerId":"98765"}]'
