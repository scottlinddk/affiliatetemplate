# Demo works without environment variables. Copy to .env.local to configure.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional deployment subdirectory. Leave empty for a domain-root site.
NEXT_PUBLIC_BASE_PATH=
# Keep a public template example outside search indexes, even with real products.
NEXT_PUBLIC_TEMPLATE_SHOWCASE=false
NEXT_PUBLIC_PUBLISHER_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
PARTNER_ADS_PARTNER_ID=
# Server-only base URL of a separately running partner-ads-json-feed service.
# Use the deployed service URL outside local development.
# Existing deployment: https://partner-ads-json-feed.vercel.app
PARTNER_ADS_API_URL=http://localhost:1337
# Only use DKK extracts for a single approved advertiser per entry.
# rid is the feed extract ID, not the program, partner, or banner ID.
# programId is optional. Omit it if unknown; never substitute rid or bannerId.
# Existing affiliate URLs are preserved. bannerId + PARTNER_ADS_PARTNER_ID are
# only needed to construct tracking links from otherwise direct merchant URLs.
# Placeholder extract below; replace with your approved extract and merchant.
# PARTNER_ADS_FEEDS='[{"rid":"1234","merchant":"Din butik","approved":true,"currency":"DKK"}]'
# Optional known program and deeplink banner IDs: "programId":"12345","bannerId":"98765"
